{
  "expo": {
    "name": "artinus-fe-test",
    "slug": "artinus-fe-test",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ch9294.artinusfetest"
    },
    "android": {
      "package": "com.ch9294.artinusfetest",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "글자를 촬영할 수 있도록 카메라 접근을 허용해 주세요.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "deploymentTarget": "16.4",
            "usePrecompiledModules": false
          }
        }
      ],
      "./plugins/withOcrPodModels",
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": ["latin", "korean"],
          "ocrUseBundled": true
        }
      ]
    ]
  }
}
